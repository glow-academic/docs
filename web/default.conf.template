resolver 127.0.0.11 valid=10s ipv6=off;

map "${ACTIVE_ENV}" $app_backend {
    "green"   app-green:3000;
    default   app-blue:3000;
}

# Preserve upstream proto (Traefik sets X-Forwarded-Proto: https).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    proxy_buffering on;
    proxy_buffer_size 128k;
    proxy_buffers 8 256k;
    proxy_busy_buffers_size 256k;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    location = /health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # MCP server — docs tools (search, API reference, CLI reference, etc.)
    # Served by the Next.js app via MCP Streamable HTTP protocol.
    # Auth handled by better-auth OAuth (docs domain) or Glow API JWT.
    location = /mcp {
        set $backend $app_backend;
        proxy_pass         http://$backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_set_header   X-Forwarded-Host  $host;

        # SSE support for MCP streaming
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }

    # Docs app — everything else
    # This handles /.well-known/* (served by better-auth for OAuth discovery),
    # /api/auth/* (better-auth OAuth endpoints), and all doc pages.
    location / {
        set $backend $app_backend;
        proxy_pass         http://$backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_set_header   X-Forwarded-Host  $host;
    }

    location /_next/static/ {
        set $backend $app_backend;
        proxy_pass         http://$backend;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }
}
