  "subcommands": [
    {
      "about": "Authenticate with Glow instance",
      "args": [
        {
          "help": "Pre-issued JWT to store as the access token. When set, the OAuth redirect flow is skipped and the token is persisted keyed on the instance URL. No refresh_token is recorded — the server enforces expiry via the token's own ``exp`` claim",
          "long": "--token",
          "name": "token",
          "required": false
        },
        {
          "help": "OAuth client ID. Defaults to the value from ``--client-id`` / ``$GLOW_CLIENT_ID`` / config / \"glow-cli\". Ignored when ``--token`` is set",
          "long": "--client-id",
          "name": "client_id",
          "required": false
        }
      ],
      "name": "login"
    },
    {
      "about": "Sign out: fire ``GET /logout`` server-side (writes a ``logouts_entry`` row so the next request mints a fresh session) and then clear the local stored token. The server-side call is best-effort — local clear always runs",
      "name": "logout"
    },
    {
      "about": "MCP — talk to the Glow instance's Model Context Protocol endpoint at ``/mcp/``. Currently a JSON-RPC client thin enough to list + call tools without dragging in a full MCP crate",
      "name": "mcp",
      "subcommands": [
        {
          "about": "List the MCP tools the Glow instance exposes. → POST /mcp/ with JSON-RPC ``tools/list``",
          "name": "list-tools"
        },
        {
          "about": "Call an MCP tool by name with a JSON arguments object. → POST /mcp/ with JSON-RPC ``tools/call``",
          "args": [
            {
              "help": "Tool name (as it appears in ``list-tools`` output)",
              "name": "tool_name",
              "required": true
            },
            {
              "help": "JSON arguments object (defaults to ``{}``)",
              "long": "--args",
              "name": "args",
              "required": false
            }
          ],
          "name": "call"
        }
      ]
    },
    {
      "about": "Generate shell completions",
      "args": [
        {
          "help": "Shell to generate completions for",
          "name": "shell",
          "required": true
        }
      ],
      "name": "completions"
    },
    {
      "about": "Start the CLI dev server (serves CLI spec + exec endpoint)",
      "args": [
        {
          "env": "GLOW_CLI_PORT",
          "help": "Port to listen on",
          "long": "--port",
          "name": "port",
          "required": false
        }
      ],
      "name": "serve"
    },
    {
      "about": "Interactive wizard: scaffold a `glow-deploy.yaml` under `~/.glow/instances/<name>/`. Walks you through origin URL, AI provider + key, seed template, and optional OIDC. Idempotent — re-running overwrites the yaml",
      "args": [
        {
          "long": "--name",
          "name": "name",
          "required": false
        }
      ],
      "name": "init"
    },
    {
      "about": "Tail container logs (`docker compose logs [-f]`)",
      "args": [
        {
          "long": "--name",
          "name": "name",
          "required": false
        },
        {
          "help": "Follow log output",
          "long": "--follow",
          "name": "follow",
          "required": false,
          "short": "-f"
        },
        {
          "help": "Optional service name (e.g. `server-blue`, `database`)",
          "name": "service",
          "required": false
        }
      ],
      "name": "logs"
    },
    {
      "about": "Deploy a Glow instance to the local machine (first-time setup). Reads `~/.glow/instances/<name>/glow-deploy.yaml`. Run `glow init` first to scaffold one interactively",
      "args": [
        {
          "help": "Instance name (defaults to \"default\")",
          "long": "--name",
          "name": "name",
          "required": false
        },
        {
          "help": "API image version, e.g. `v1.0.0`",
          "long": "--api-version",
          "name": "api_version",
          "required": false
        },
        {
          "help": "Client image version (required unless topology=api_only)",
          "long": "--client-version",
          "name": "client_version",
          "required": false
        },
        {
          "help": "Seed template for first deploy: fresh | university | organization",
          "long": "--seed-setup",
          "name": "seed_setup",
          "required": false
        },
        {
          "help": "Grace period (minutes) to watch the new color after traffic swap",
          "long": "--grace-minutes",
          "name": "grace_minutes",
          "required": false
        }
      ],
      "name": "deploy"
    },
    {
      "about": "Roll out a new version while keeping the database. Auto-pre-backs up before doing anything destructive, blue/green swaps with healthcheck monitoring + auto-rollback if the new color flaps",
      "args": [
        {
          "long": "--name",
          "name": "name",
          "required": false
        },
        {
          "long": "--api-version",
          "name": "api_version",
          "required": false
        },
        {
          "help": "Client image tag — falls back to the last-deployed version recorded in state when omitted",
          "long": "--client-version",
          "name": "client_version",
          "required": false
        },
        {
          "help": "Restore from a named backup as part of the redeploy",
          "long": "--from-backup",
          "name": "from_backup",
          "required": false
        },
        {
          "help": "DESTRUCTIVE: re-run seed-gen and wipe the DB. Use with care",
          "long": "--reseed",
          "name": "reseed",
          "required": false
        },
        {
          "long": "--grace-minutes",
          "name": "grace_minutes",
          "required": false
        }
      ],
      "name": "redeploy"
    },
    {
      "about": "Stop containers; volumes + network intact. `glow start` resumes",
      "args": [
        {
          "long": "--name",
          "name": "name",
          "required": false
        }
      ],
      "name": "stop"
    },
    {
      "about": "Resume previously-stopped containers",
      "args": [
        {
          "long": "--name",
          "name": "name",
          "required": false
        }
      ],
      "name": "start"
    },
    {
      "about": "Tear down containers + volumes (DESTROYS DATA — confirm twice). Config + backups under `~/.glow/instances/<name>/` are preserved",
      "args": [
        {
          "long": "--name",
          "name": "name",
          "required": false
        }
      ],
      "name": "destroy"
    },
    {
      "about": "Show instance state + per-container health",
      "args": [
        {
          "long": "--name",
          "name": "name",
          "required": false
        }
      ],
      "name": "status"
    },
    {
      "about": "Manage local pg_dump backups",
      "name": "backup",
      "subcommands": [
        {
          "about": "List local backups for an instance",
          "args": [
            {
              "long": "--name",
              "name": "name",
              "required": false
            }
          ],
          "name": "list"
        },
        {
          "about": "Create a new pg_dump backup",
          "args": [
            {
              "long": "--name",
              "name": "name",
              "required": false
            },
            {
              "help": "Optional label tag; filename becomes `manual-<label>-<ts>.sql.gz`",
              "long": "--label",
              "name": "label",
              "required": false
            }
          ],
          "name": "create"
        },
        {
          "about": "Restore an existing backup (destructive — drops + recreates DB)",
          "args": [
            {
              "long": "--name",
              "name": "name",
              "required": false
            },
            {
              "help": "Backup filename inside the instance's `backups/` dir",
              "name": "file",
              "required": true
            }
          ],
          "name": "restore"
        },
        {
          "about": "Delete a backup file",
          "args": [
            {
              "long": "--name",
              "name": "name",
              "required": false
            },
            {
              "name": "file",
              "required": true
            }
          ],
          "name": "delete"
        }
      ]
    }
  ],
  "version": "1.0.0"
}
