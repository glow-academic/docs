{
  "about": "Glow CLI — manage your platform",
  "args": [
    {
      "env": "GLOW_API_URL",
      "help": "LearnLoop API URL (central platform)",
      "long": "--api-url",
      "name": "api_url",
      "required": false
    },
    {
      "env": "GLOW_INSTANCE_URL",
      "help": "Glow instance URL",
      "long": "--instance-url",
      "name": "instance_url",
      "required": false
    },
    {
      "env": "GLOW_LICENSE_KEY",
      "help": "License key",
      "long": "--license-key",
      "name": "license_key",
      "required": false
    },
    {
      "env": "GLOW_CLIENT_ID",
      "help": "OAuth client ID",
      "long": "--client-id",
      "name": "client_id",
      "required": false
    },
    {
      "global": true,
      "help": "Output in JSON format",
      "long": "--json",
      "name": "json",
      "required": false
    },
    {
      "global": true,
      "help": "Skip confirmation prompts for destructive actions",
      "long": "--yes",
      "name": "yes",
      "required": false,
      "short": "-y"
    }
  ],
  "media_actions": [
    {
      "about": "Upload a file via multipart form",
      "args": [
        {
          "help": "Path to file to upload",
          "long": "--file",
          "name": "file",
          "required": true
        }
      ],
      "name": "upload"
    },
    {
      "about": "Download a media file",
      "args": [
        {
          "help": "Upload ID",
          "long": "--id",
          "name": "id",
          "required": true
        },
        {
          "help": "Output file path (stdout if omitted)",
          "long": "--output",
          "name": "output",
          "required": false
        }
      ],
      "name": "download"
    },
    {
      "about": "Initiate a TUS resumable upload",
      "args": [
        {
          "help": "Filename for the upload",
          "long": "--filename",
          "name": "filename",
          "required": true
        },
        {
          "help": "Total file size in bytes",
          "long": "--size",
          "name": "size",
          "required": false
        }
      ],
      "name": "create"
    },
    {
      "about": "Upload a chunk for a TUS upload",
      "args": [
        {
          "help": "Upload ID",
          "long": "--id",
          "name": "id",
          "required": true
        },
        {
          "help": "Path to chunk data",
          "long": "--file",
          "name": "file",
          "required": true
        },
        {
          "help": "Byte offset (default: 0)",
          "long": "--offset",
          "name": "offset",
          "required": false
        }
      ],
      "name": "chunk"
    },
    {
      "about": "Check TUS upload status",
      "args": [
        {
          "help": "Upload ID",
          "long": "--id",
          "name": "id",
          "required": true
        }
      ],
      "name": "status"
    },
    {
      "about": "Finalize a TUS upload",
      "args": [
        {
          "help": "Upload ID",
          "long": "--id",
          "name": "id",
          "required": true
        },
        {
          "help": "Optional JSON body",
          "long": "--body",
          "name": "body",
          "required": false
        }
      ],
      "name": "finalize"
    },
    {
      "about": "Discover available upload types",
      "args": [
        {
          "help": "Optional upload ID",
          "long": "--id",
          "name": "id",
          "required": false
        }
      ],
      "name": "discover"
    },
    {
      "about": "Preview a media file",
      "args": [
        {
          "help": "Upload ID",
          "long": "--id",
          "name": "id",
          "required": true
        }
      ],
      "name": "preview"
    }
  ],
